@{
    ViewData["Title"] = "CreateTestimonialWithAnthropicClaude";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var testimonials = ViewBag.testimonials;
}

<div class="cont-mt-5">
    <h2>Claude AI ile Oluşturulan Müşteri Yorum ve Değerlendirme İçerikleri</h2>
    <ul class="list-group mt-3">
        @if (testimonials != null)
        {
            foreach (var item in testimonials)
            {
                <li class="list-group-item alert-success">@item</li>
            }
        }
        else
        {
            <li class="list-group-item text-danger">Claude' dan Veri Alınamadı: @ViewBag.testimonials</li>
        }
    </ul>
</div>

